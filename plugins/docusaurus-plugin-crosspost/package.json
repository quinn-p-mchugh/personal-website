{
  "name": "docusaurus-plugin-crosspost",
  "version": "0.2.0",
  "private": true,
  "description": "Cross-post Docusaurus blog posts to Mastodon and Bluesky with Bridgy, and show the replies, likes and reposts under each post.",
  "keywords": [
    "docusaurus",
    "docusaurus-plugin",
    "indieweb",
    "posse",
    "bridgy",
    "mastodon",
    "bluesky",
    "webmention",
    "microformats"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "docusaurus-plugin-crosspost": "src/cli/main.js"
  },
  "files": [
    "src",
    "workflows",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@docusaurus/core": "^3.6.0",
    "@docusaurus/plugin-content-blog": "^3.6.0",
    "@docusaurus/theme-common": "^3.6.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@docusaurus/utils": "^3.6.0",
    "@docusaurus/utils-common": "^3.6.0",
    "@docusaurus/utils-validation": "^3.6.0",
    "clsx": "^2.0.0",
    "entities": "^8.0.0",
    "htmlparser2": "^12.0.0",
    "sharp": "^0.35.0"
  }
